# Server-only provider credentials. Leave values empty in version control.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Configurable, pinned model IDs. Confirm the OpenAI model choices before use.
OPENAI_NICHE_MODEL=
OPENAI_WRITER_MODEL=
JEV_MODEL=typesafe/jev-1.13

# Development only. Set to true in .env.local to capture the bundled localhost demo.
# Never enable private-network capture in production.
ALLOW_PRIVATE_CAPTURE=false

# Optional visible-copy ceiling. Leave blank to use the 30,000-character default.
CAPTURE_MAX_COPY_CHARACTERS=
